{
  "navigationFallback": {
    "rewrite": "/index.html",
    "exclude": ["/api/*", "/s/*", "/*.{png,svg,ico,css,js,ttf}"]
  },
  "routes": [
    { "route": "/s/*", "rewrite": "/api/share" },
    { "route": "/api/*", "allowedRoles": ["anonymous", "authenticated"] }
  ],
  "responseOverrides": {
    "404": { "rewrite": "/index.html" }
  }
}
